---
import { siteConfig, withBase } from "../config/site";
---

<footer class="site-footer">
  <div class="site-footer__inner container">
    <p>© {new Date().getFullYear()} {siteConfig.author}. Fotografias: todos os direitos reservados.</p>
    <div class="site-footer__actions">
      <a href={withBase("/")}>Início</a>
      <a href={withBase("/sobre/")}>Sobre</a>
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Alternar tema" aria-pressed="false">
        <svg class="theme-icon theme-icon--light" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.6" />
          <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.6" />
        </svg>
        <svg class="theme-icon theme-icon--dark" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M20.4 14.2A8.5 8.5 0 0 1 9.8 3.6 8.5 8.5 0 1 0 20.4 14.2Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" />
        </svg>
        <span class="sr-only" data-theme-label>Alternar tema</span>
      </button>
    </div>
  </div>
</footer>
